#!/bin/bash
# -------------------------------------------------------------
# 🔮 [내 운세 지금은] 더블클릭 한 번으로 깃허브 & 렌더 자동 배포 프로그램
# -------------------------------------------------------------

echo "====================================================="
echo "🔮 [내 운세 지금은] 사이트 업데이트 및 자동 배포를 시작합니다..."
echo "====================================================="

# 프로젝트 루트 폴더로 이동
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null 2>&1 && pwd )"
cd "$DIR"

# 변경된 내용 추가
git add -A

# 현재 일시로 커밋 메시지 작성
NOW=$(date "+%Y-%m-%d %H:%M:%S")
git commit -m "내 운세 지금은 업데이트 ($NOW)"

# 깃허브로 푸시
echo "🌐 깃허브로 변경 사항을 전송 중입니다..."
git push

echo "====================================================="
echo "✅ 깃허브 전송이 완료되었습니다!"
echo "🚀 연동된 Render(렌더)에서 약 1분 후 최신 사이트로 자동 배포됩니다."
echo "====================================================="
echo "이 창을 닫으셔도 됩니다."
